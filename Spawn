-- 2. SECURE LOADER SCREEN
---------------------------------------------------------
local loaderGui = Instance.new("ScreenGui")
loaderGui.Name = "SecureLoaderGui"
loaderGui.ResetOnSpawn = false
loaderGui.Parent = guiParent

local loaderFrame = Instance.new("Frame")
loaderFrame.Name = "MainFrame"
loaderFrame.Size = UDim2.new(0, 480, 0, 240)
loaderFrame.Position = UDim2.new(0.5, -240, 0.5, -120)
loaderFrame.BackgroundColor3 = Color3.fromRGB(15, 18, 28)
loaderFrame.BorderSizePixel = 0
loaderFrame.Active = true
loaderFrame.Draggable = true
loaderFrame.ClipsDescendants = true
loaderFrame.Parent = loaderGui

-- [Omitted setup code for brevity, but same UI construction as before]
-- ... (All other UI elements remain identical)
-- The only change is the line below:
local totalDuration = 60 -- UPDATED TO 1 MINUTE
local startTime = tick()

-- Progress Line Animation
local progressTween = TweenService:Create(
    fillFrame, 
    TweenInfo.new(totalDuration, Enum.EasingStyle.Linear), 
    {Size = UDim2.new(1, 0, 1, 0)}
)
progressTween:Play()

-- Lifecycle Loop
task.spawn(function()
    while true do
        local elapsed = tick() - startTime
        local progress = math.clamp(elapsed / totalDuration, 0, 1)
        local percentValue = progress * 100
        
        percentLabel.Text = string.format("%.1f%%", percentValue)
        
        if percentValue >= 85 then
            statusLabel.Text = "finalizing injection & security checks..."
        elseif percentValue >= 60 then
            statusLabel.Text = "decrypting script payload..."
        elseif percentValue >= 35 then
            statusLabel.Text = "bypassing security checks..."
        elseif percentValue >= 15 then
            statusLabel.Text = "fetching remote assets..."
        end
        
        if progress >= 1 then
            percentLabel.Text = "100.0%"
            statusLabel.Text = "successfully loaded!"
            statusLabel.TextColor3 = Color3.fromRGB(90, 230, 140)
            
            task.wait(0.8)
            
            local fadeInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local fadeOut = TweenService:Create(loaderFrame, fadeInfo, {
                Position = UDim2.new(0.5, -240, 0.5, -140),
                BackgroundTransparency = 1
            })
            
            for _, child in ipairs(loaderFrame:GetDescendants()) do
                if child:IsA("TextLabel") then
                    TweenService:Create(child, fadeInfo, {TextTransparency = 1}):Play()
                elseif child:IsA("Frame") then
                    TweenService:Create(child, fadeInfo, {BackgroundTransparency = 1}):Play()
                elseif child:IsA("UIStroke") then
                    TweenService:Create(child, fadeInfo, {Transparency = 1}):Play()
                end
            end
            
            fadeOut:Play()
            fadeOut.Completed:Wait()
            
            loaderGui:Destroy()
            initializeFruitSpawner()
            break
        end
        
        task.wait(0.04)
    end
end)
